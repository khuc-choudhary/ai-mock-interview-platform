# ---------- Core ----------
APP_ENV=development
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/mock_interview
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ---------- LLM (any OpenAI-compatible chat completions API) ----------
# Leave LLM_API_KEY empty to run in clearly-labelled DEMO MODE (sample questions, heuristic scoring, NOT real AI).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to false for providers that reject response_format=json_object
LLM_JSON_MODE=true

# Other OpenAI-compatible examples:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=openai/gpt-4o-mini
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1

# ---------- Whisper-compatible speech-to-text (optional) ----------
# Falls back to LLM_BASE_URL / LLM_API_KEY when blank. Groq: https://api.groq.com/openai/v1 + whisper-large-v3
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

INTERVIEWER_NAME=Aria

# ---------- Rate limiting (per user, AI endpoints) ----------
RATE_LIMIT_AI=30
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---------- SMTP for password-reset emails (optional; without it the link is logged / shown in dev) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mockinterview.local

# ---------- Production extras ----------
# Reasoning models (e.g. gpt-oss on Groq): low | medium | high. Lower = faster/cheaper.
LLM_REASONING_EFFORT=low
# HTTP email API (https://resend.com) - works where SMTP is blocked. SMTP_FROM must be an address Resend allows.
RESEND_API_KEY=
